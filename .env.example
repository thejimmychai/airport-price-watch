# Google AI Studio / Gemini API Key (enables live multimodal & agent reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets Database Backend (Zero-GCP-Billing Storage)
GSHEETS_ENABLED=true
GSHEETS_SPREADSHEET_ID=1wZykxwH2V4r54dYVXtM9RKAbWpcruIWcyDk9CqDENDE

# Envelope Encryption Master Key (or Cloud KMS Key Resource Name in production)
APP_ENCRYPTION_KEY=change-this-to-a-32-byte-secret-in-production
GCP_KMS_KEY_NAME=projects/your-gcp-project/locations/us-central1/keyRings/apw-ring/cryptoKeys/volunteer-consent-key

# Server Port
PORT=8080
